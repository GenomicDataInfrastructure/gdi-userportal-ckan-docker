# Copy this file to .env and change every value marked changeme. Never commit .env.

# CKAN databases
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres
POSTGRES_HOST=db
CKAN_DB_USER=ckandbuser
CKAN_DB_PASSWORD=changeme
CKAN_DB=ckandb
# Repeats CKAN_DB_USER, CKAN_DB_PASSWORD and CKAN_DB: change them here too.
CKAN_SQLALCHEMY_URL=postgresql://ckandbuser:changeme@db/ckandb

# Dev settings
USE_HTTPS_FOR_DEV=false
# Start the dev server under debugpy on port 5678 in the container. Off by default, and
# docker-compose.yml does not publish port 5678 to the host.
USE_DEBUGPY_FOR_DEV=false

# Host Ports
CKAN_PORT_HOST=5500

# CKAN core
CKAN_SITE_ID=default
CKAN_SITE_URL=http://localhost:5500

CKAN___BEAKER__SESSION__SECRET=changeme
# See https://docs.ckan.org/en/latest/maintaining/configuration.html#api-token-settings
CKAN___API_TOKEN__JWT__ENCODE__SECRET=changeme
CKAN___API_TOKEN__JWT__DECODE__SECRET=changeme
CKAN_SYSADMIN_NAME=ckan_admin
CKAN_SYSADMIN_PASSWORD=changeme
CKAN_SYSADMIN_EMAIL=your_email@example.com
CKAN_STORAGE_PATH=/var/lib/ckan
CKAN_SMTP_SERVER=smtp.corporateict.domain:25
CKAN_SMTP_STARTTLS=True
CKAN_SMTP_USER=user
CKAN_SMTP_PASSWORD=changeme
CKAN_SMTP_MAIL_FROM=ckan@localhost
CKAN_MAX_UPLOAD_SIZE_MB=10
TZ=Europe/Amsterdam
CKAN__LOCALE_DEFAULT=en

# Redis
REDIS_VERSION=7.4.2
CKAN_REDIS_URL=redis://redis:6379/1

# Solr
CKAN_SOLR_URL=http://solr:8983/solr/ckan

# Extensions
CKAN__PLUGINS="envvars gdi_userportal scheming_datasets scheming_organizations gdi_userportalharvester dcat dataset_series dcat_json_interface harvest ckan_harvester dcat_rdf_harvester dcat_json_harvester fluent fairdatapointharvester activity"
CKAN__HARVEST__MQ__HOSTNAME=redis
CKAN__HARVEST__MQ__PORT=6379
CKAN__HARVEST__MQ__REDIS_DB=1
CKAN__HARVEST__MQ__PASSWORD=changeme
CKAN__HARVEST__MQ__TYPE=redis
CKANEXT_FAIRDATAPOINT_BIOPORTAL_API_KEY=changeme

# Access key pair of the S3 RDF harvester. The production start script writes them into the ini.
CKAN_HARVEST_S3_RDF_AWS_ACCESS_KEY=
CKAN_HARVEST_S3_RDF_AWS_SECRET_KEY=

# Metadata profiles: the variables and their semantics are documented in docs/metadata-profiles.md.
# Read its "Known limits" section before enabling healthdcat_r8.
GDI_METADATA_PROFILES=gdi_current
GDI_METADATA_MAIN_PROFILE=gdi_current
# Languages of the edit form for multilingual fields. Unset: CKAN__LOCALES_OFFERED, else en nl.
# GDI_METADATA_FORM_LANGUAGES=en nl

# Show every schema property on dataset and distribution pages, with a dash for empty ones.
# For inspecting the schema; off by default.
CKANEXT__GDI_USERPORTAL__SHOW_EMPTY_PROPERTIES=false

# Set to true to skip the database setup and sysadmin creation in prerun.py. Unset by default.
# MAINTENANCE_MODE=true

# Seconds before uwsgi kills a request that runs longer. Read by the production start script only.
# UWSGI_HARAKIRI=60

#Logger
# The development start script always enables debug, so this value has no effect in dev.
CKAN___DEBUG=true
CKAN__HARVEST__LOG_LEVEL=DEBUG
CKAN___LOGGER_CKANEXT__LEVEL=DEBUG

#OTEL
OTEL_SDK_DISABLED=true
