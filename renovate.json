{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges",
    ":dependencyDashboard",
    ":rebaseStalePrs",
    ":enableVulnerabilityAlertsWithLabel('security')",
    "group:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "description": "Extensions installed from a git tag in the Dockerfiles: git+https://github.com/<owner>/<repo>.git@<tag>",
      "customType": "regex",
      "managerFilePatterns": ["/^ckan/Dockerfile(\\.dev)?$/"],
      "matchStrings": [
        "git\\+https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+?)\\.git@(?<currentValue>[^#'\\s]+)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies", "require-dev"],
      "matchUpdateTypes": ["patch", "minor", "major"],
      "groupName": "devDependencies"
    },
    {
      "description": "Trigger fix release for patch updates",
      "matchPackageNames": [
        "renovate/renovate",
        "ghcr.io/renovatebot/renovate"
      ],
      "automerge": true,
      "matchUpdateTypes": ["patch"],
      "semanticCommitType": "fix",
      "automergeType": "pr"
    }
  ]
}
